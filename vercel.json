{
  "version": 2,
  "functions": {
    "api/**/*.php": { "runtime": "vercel-php@0.7.2" }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/admin", "dest": "/api/admin/index.php" },
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/(.*\\.php)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/api/$1.php" }
  ]
}
